// ==========================
// 12 Security Events
// ==========================

model SecurityEvent {
  id        String   @id @default(uuid())
  apiKeyId  String?
  accountId String?
  type      String // SecurityEventType enum value
  ip        String?
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Append-only — no updatedAt
  apiKey  ApiKey?  @relation(fields: [apiKeyId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([apiKeyId])
  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

// ==========================
// 13 Audit Logs
// ==========================
model AuditLog {
  id           String   @id @default(uuid())
  accountId    String?
  userId       String?
  targetUserId String? // affected user
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([accountId])
  @@index([accountId, createdAt]) // team activity feed
  @@index([userId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

// Models 14 (an earlier draft of UsageAggregate) and 15 (UsageReport, a
// separate table for Stripe usage-reporting status) were an abandoned
// metered-billing design, superseded by folding reportedToStripe/
// stripeUsageRecordId directly onto the live UsageAggregate model above.
// Removed 2026-09-13 as part of formally deciding against metered billing
// (flat-rate tiers only) — see decision.md, "Billing model: flat-rate
// tiers". Neither model was ever active (both fully commented out).

// ==========================
// 16 Stripe Events (Webhook Tracking)
// ==========================
model StripeEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime
}

model Feedback {
  id        String  @id @default(uuid())
  userId    String
  accountId String?

  type     FeedbackType
  status   FeedbackStatus   @default(OPEN)
  priority FeedbackPriority @default(MEDIUM)

  title            String
  description      String
  stepsToReproduce String?
  expectedBehavior String?
  actualBehavior   String?

  pageUrl    String?
  userAgent  String?
  appVersion String?

  attachments String[]  @default([])
  adminNotes  String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([priority])
  @@index([createdAt])
}

// ============================================
// 2. ADMIN SYSTEM (Separate from User)
// ============================================

// ========== Admin User ==========
model AdminUser {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String

  firstName String
  lastName  String

  status Boolean @default(true)

  // Super Admin Protection (immutable once set to true)
  isSuperAdmin Boolean @default(false)

  // Signed into admin access tokens; bumping it (logout) revokes every
  // outstanding token at once, like User.tokenVersion.
  tokenVersion Int @default(0)

  // Sign-in lockout, same scheme as User (5 failures -> 15 minutes).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // ← soft delete

  // Relations
  roles                 AdminUserRole[]
  sessions              AdminSession[]
  auditLogs             AdminAuditLog[]
  createdAuditLogs      AdminAuditLog[]        @relation("CreatedBy")
  roleAssignments       AdminUserRoleHistory[]
  assignedRolesByOthers AdminUserRoleHistory[] @relation("AssignedBy")

  @@index([email])
  @@index([status])
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime? // ← allow token revocation
  createdAt DateTime  @default(now())
  ipAddress String
  userAgent String

  // Rotation grace (same scheme as Session): the session that replaced this
  // one, and the successor's raw token encrypted for 30 s, so a token
  // presented twice at once (two tabs) gets the same successor instead of
  // triggering reuse detection.
  replacedById           String?
  replacementTokenCipher String?

  // Rotation never extends the session past this (audit M23).
  absoluteExpiresAt DateTime?

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tokenHash])
}

// ========== Admin Role ==========
model AdminRole {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  // System roles: Super Admin, Admin, Moderator (cannot be deleted)
  isSystem Boolean @default(false)
  isActive Boolean @default(true) // ← soft delete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  abilities AdminRoleAbility[]
  users     AdminUserRole[]
  history   AdminUserRoleHistory[]

  @@index([name])
  @@index([isActive])
}

// ========== Admin Ability (Granular Permissions) ==========
model AdminAbility {
  id          String  @id @default(uuid())
  action      String // e.g., "user.create", "user.read", "user.update", "user.delete"
  category    String // e.g., "users", "roles", "settings", "audit_logs"
  description String?

  // System abilities: cannot be modified
  isSystem Boolean @default(true)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  roles AdminRoleAbility[]

  @@unique([category, action])
  @@index([category])
  @@index([action])
}

// ========== Admin Role → Ability Mapping ==========
model AdminRoleAbility {
  roleId    String
  abilityId String

  role    AdminRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  ability AdminAbility @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  @@id([roleId, abilityId])
  @@index([roleId])
  @@index([abilityId])
}

// ========== Admin User → Role Mapping ==========
model AdminUserRole {
  adminId String
  roleId  String

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role  AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminId, roleId])
  @@index([adminId])
  @@index([roleId])
}

// ========== Admin Audit Log (IMMUTABLE) ==========
// 🔒 Append-only audit trail. No updates allowed.
model AdminAuditLog {
  id         String  @id @default(uuid())
  adminId    String?
  action     String // e.g., "user.created", "role.assigned", "settings.updated"
  targetType String // e.g., "User", "AdminRole", "AdminAbility"
  targetId   String?

  // Track what changed
  changes Json? // { before: {...}, after: {...} }

  // Metadata for audit trail
  metadata Json? // { ipAddress, userAgent, statusCode, reason }

  createdAt DateTime @default(now()) // ← NO updatedAt (immutable)

  admin          AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull, map: "AdminAuditLog_adminId_fkey")
  createdByAdmin AdminUser? @relation("CreatedBy", fields: [adminId], references: [id], onDelete: SetNull, map: "AdminAuditLog_createdByAdminId_fkey")

  @@index([adminId])
  @@index([createdAt])
  @@index([targetType])
  @@index([targetId])
}

// ========== Admin User Role History (Track Assignments) ==========
model AdminUserRoleHistory {
  id         String  @id @default(uuid())
  adminId    String // ← the admin whose role changed
  roleId     String // ← the role being assigned/revoked
  assignedBy String? // ← which admin made the change
  action     String // "assigned" | "revoked"
  reason     String? // why was the role changed?

  createdAt DateTime @default(now())

  admin           AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  assignedByAdmin AdminUser? @relation("AssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  role            AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([roleId])
  @@index([assignedBy])
  @@index([createdAt])
}

// Two new models added to your existing schema.prisma

// Tracks active and historical agent connections
// Used by dashboard: "which tunnels are currently online"
model TunnelSession {
  id             String              @id @default(uuid())
  accountId      String
  apiKeyId       String
  agentId        String              @unique // hub-assigned, one per connection
  label          String // tunnel name
  status         TunnelSessionStatus @default(CONNECTED)
  connectedAt    DateTime            @default(now())
  disconnectedAt DateTime?
  hubInstanceId  String? // which hub process owns this session
  metadata       Json? // { agentVersion, ip }

  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  apiKey         ApiKey          @relation(fields: [apiKeyId], references: [id])
  tunnelRequests TunnelRequest[]

  @@index([accountId])
  @@index([accountId, status]) // dashboard query: active tunnels for account
  @@index([apiKeyId])
  @@index([connectedAt])
  @@index([hubInstanceId]) // hub startup: evict stale sessions for this instance
  @@map("tunnel_sessions")
}

enum TunnelSessionStatus {
  CONNECTED
  DISCONNECTED
  EVICTED // kicked for missing heartbeats
}

// Audit trail of every proxied request
// Append-only — used for analytics, debugging, billing
model TunnelRequest {
  id         String   @id @default(uuid())
  accountId  String
  apiKeyId   String
  sessionId  String // FK to TunnelSession
  requestId  String   @unique // the requestId from the protocol
  method     String
  path       String
  status     Int? // HTTP response status (null if agent never responded)
  durationMs Int?
  errorCode  String?
  createdAt  DateTime @default(now())

  account Account       @relation(fields: [accountId], references: [id])
  apiKey  ApiKey        @relation(fields: [apiKeyId], references: [id])
  session TunnelSession @relation(fields: [sessionId], references: [id])

  @@index([accountId])
  @@index([sessionId])
  @@index([requestId])
  @@index([createdAt])
  @@index([accountId, createdAt]) // usage analytics time-series query
  @@index([apiKeyId, createdAt]) // per-key analytics
  @@map("tunnel_requests")
}

model Notification {
  id        String             @id @default(uuid())
  userId    String
  accountId String?
  type      NotificationType
  title     String
  body      String
  actionUrl String?
  metadata  Json?
  status    NotificationStatus @default(SENT)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Platform: runtime settings and website content (admin panel) ───────────

/// One row per setting an admin changed; keys without a row use the default
/// from packages/shared/src/settings.ts.
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("system_settings")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Website content edited in the admin panel. `data` is the working copy;
/// `publishedData` is what the public site serves (copied on publish).
model ContentEntry {
  id             String        @id @default(uuid())
  slug           String        @unique
  kind           String
  title          String
  status         ContentStatus @default(DRAFT)
  data           Json
  publishedData  Json?
  seoTitle       String?
  seoDescription String?
  version        Int           @default(0)
  publishedAt    DateTime?
  updatedById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  revisions ContentRevision[]

  @@index([kind])
  @@index([status])
  @@map("content_entries")
}

/// Snapshot of an entry each time it is published (for history and rollback).
model ContentRevision {
  id          String   @id @default(uuid())
  entryId     String
  version     Int
  title       String
  data        Json
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  entry ContentEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, version])
  @@map("content_revisions")
}

// Access rules for one public tunnel (account + label), enforced by the hub
// before a request reaches the agent. No row = public.
//   passwordHash: HMAC-SHA256(SERVER_HMAC_PEPPER, accountId|label|password), hex
//   ipAllowlist:  addresses or CIDRs; empty = any address
//   version:      signed into share links; bumping it revokes every link
model TunnelPolicy {
  id           String   @id @default(uuid())
  accountId    String
  label        String
  passwordHash String?
  ipAllowlist  String[] @default([])
  version      Int      @default(1)
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, label])
  @@map("tunnel_policies")
}

// Traffic rules for one tunnel (account + label): an ordered list (JSON,
// shape and checks in packages/shared/src/trafficRules.ts) that the hub
// applies before forwarding: mocks, injected errors and delays, redirects,
// path rewrites, header changes. Saved as a whole so order is atomic.
model TunnelRuleSet {
  id          String   @id @default(uuid())
  accountId   String
  label       String
  rules       Json     @default("[]")
  version     Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, label])
  @@map("tunnel_rule_sets")
}

// Webhook inbox for one tunnel (account + label): while its agent is
// offline, the hub stores requests instead of answering 404/503, and
// delivers them in order when the agent reconnects.
model TunnelInbox {
  id          String   @id @default(uuid())
  accountId   String
  label       String
  enabled     Boolean  @default(true)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, label])
  @@map("tunnel_inboxes")
}

enum InboxStatus {
  QUEUED
  DELIVERING
  DELIVERED
  FAILED
}

// One request held by a tunnel's inbox. Deleted INBOX_RETENTION_DAYS after
// it arrived, whatever its state.
model InboxRequest {
  id             String      @id @default(uuid())
  accountId      String
  label          String
  method         String
  path           String
  headers        Json
  body           Bytes?
  bodySize       Int         @default(0)
  receivedAt     DateTime    @default(now())
  status         InboxStatus @default(QUEUED)
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now())
  lastError      String?
  responseStatus Int?
  deliveredAt    DateTime?
  updatedAt      DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, label, status, receivedAt])
  @@index([status, nextAttemptAt])
  @@index([receivedAt])
  @@map("inbox_requests")
}

// A customer's own hostname serving one of their tunnels. Several accounts
// may claim the same hostname while unverified; at most one verified claim
// exists per hostname (partial unique index in the migration). The hub
// routes only verified domains; the edge only issues certificates for them.
model CustomDomain {
  id                String    @id @default(uuid())
  accountId         String
  hostname          String
  label             String
  verificationToken String
  verifiedAt        DateTime?
  routingOk         Boolean   @default(false)
  lastCheckedAt     DateTime?
  lastError         String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, hostname])
  @@index([hostname])
  @@index([verifiedAt, lastCheckedAt])
  @@map("custom_domains")
}

enum AlertType {
  TUNNEL_OFFLINE
  ERROR_RATE
  USAGE
  INBOX_FAILED
  DOMAIN
  MONITOR
}

// One alert rule of an account (rules in packages/shared/src/alerts.ts).
model AlertRule {
  id            String    @id @default(uuid())
  accountId     String
  name          String
  type          AlertType
  enabled       Boolean   @default(true)
  label         String? // tunnel scope; null = every tunnel
  threshold     Int? // ERROR_RATE / USAGE percent
  windowMinutes Int? // TUNNEL_OFFLINE / ERROR_RATE
  minRequests   Int? // ERROR_RATE
  notifyMembers Boolean   @default(true) // in-app + email to owners and admins
  emails        String[]  @default([])
  webhookUrl    String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Event rules: where the last evaluation stopped.
  cursorAt      DateTime?

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  states  AlertState[]
  events  AlertEvent[]

  @@index([accountId])
  @@index([enabled, type])
  @@map("alert_rules")
}

// What is firing now for a state rule, per subject (tunnel label, usage period).
model AlertState {
  id      String   @id @default(uuid())
  ruleId  String
  subject String
  firing  Boolean
  since   DateTime @default(now())
  detail  Json?

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, subject])
  @@map("alert_states")
}

// History shown in the dashboard; one row per notification sent (or suppressed).
model AlertEvent {
  id         String   @id @default(uuid())
  ruleId     String
  accountId  String
  subject    String
  kind       String // FIRING | RESOLVED | EVENT
  title      String
  message    String
  deliveries Json? // { email: n, inApp: n, webhook: "ok" | "error: …", suppressed?: true }
  createdAt  DateTime @default(now())

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([ruleId, createdAt])
  @@map("alert_events")
}

// Public traffic per tunnel per minute, written by the hub (batched). Feeds
// error-rate alerts and traffic charts. Kept TUNNEL_STATS_RETENTION_DAYS.
model TunnelMinuteStat {
  accountId String
  label     String
  minute    DateTime
  requests  Int      @default(0)
  errors4xx Int      @default(0)
  errors5xx Int      @default(0)
  totalMs   BigInt   @default(0)

  @@id([accountId, label, minute])
  @@index([minute])
  @@map("tunnel_minute_stats")
}

// Public traffic per endpoint (method + route pattern) per 5 minutes, written
// by the hub with TunnelMinuteStat (phase 4 analytics). hist = latency
// histogram counts (bounds in packages/shared/src/perf.ts), added up on merge.
model TunnelEndpointStat {
  accountId String
  label     String
  method    String
  route     String
  bucket    DateTime
  requests  Int      @default(0)
  s2xx      Int      @default(0)
  s3xx      Int      @default(0)
  s4xx      Int      @default(0)
  s5xx      Int      @default(0)
  totalMs   BigInt   @default(0)
  maxMs     Int      @default(0)
  hist      Int[]
  /// One concrete path seen (to match against a spec's patterns).
  sample    String   @default("")

  @@id([accountId, label, method, route, bucket])
  @@index([bucket])
  @@index([accountId, bucket])
  @@map("tunnel_endpoint_stats")
}

// Lets exactly one API instance run a periodic job at a time.
model JobLease {
  name      String   @id
  holder    String
  expiresAt DateTime

  @@map("job_leases")
}

// One row per account notice that must go out once (usage 80/100 % per month,
// trial ending per trial). Inserting the row claims the notice, so two API
// instances or the Stripe webhook and the job never send it twice.
model AccountNotice {
  id        String   @id @default(uuid())
  accountId String
  kind      String
  period    String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind, period])
  @@map("account_notices")
}

enum MockApiMode {
  ALWAYS
  OFFLINE
}

/// A hosted mock API bound to a tunnel label (internal-tools/shared/api-platform-plan.md, phase 1).
/// The hub serves it at <slug>--<label>; the definition is validated by packages/shared/src/mockApi.ts.
model MockApi {
  id          String      @id @default(uuid())
  accountId   String
  label       String
  name        String
  description String      @default("")
  enabled     Boolean     @default(true)
  mode        MockApiMode @default(ALWAYS)
  cors        Boolean     @default(true)
  latencyMs   Int         @default(0)
  endpoints   Json        @default("[]")
  /// Stateful REST collections (packages/shared/src/mockResources.ts); data lives in Redis.
  resources   Json        @default("[]")
  /// Bumped on every save; a stale save is refused (409).
  version     Int         @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, label])
  @@map("mock_apis")
}

/// API client collections (internal-tools/shared/api-platform-plan.md, phase 3;
/// packages/shared/src/apiClient.ts). Folders and requests are JSON, checked by
/// apiCollectionProblem on every save.
model ApiCollection {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  description String   @default("")
  /// Default auth for requests set to "inherit".
  auth        Json     @default("{\"type\":\"none\"}")
  variables   Json     @default("[]")
  folders     Json     @default("[]")
  requests    Json     @default("[]")
  /// Bumped on every save; a stale save is refused (409).
  version     Int      @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  runs     ApiTestRun[]
  monitors ApiMonitor[]

  @@index([accountId])
  @@map("api_collections")
}

/// Named variable sets (Local, Staging, Production). Secret values are
/// encrypted (AES-256-GCM, key from SERVER_HMAC_PEPPER) and never returned.
model ApiEnvironment {
  id          String   @id @default(uuid())
  accountId   String
  name        String
  variables   Json     @default("[]")
  version     Int      @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, name])
  @@map("api_environments")
}

/// Requests a member sent from the API client (theirs only; the latest 200 kept).
model ApiRequestHistory {
  id         String   @id @default(uuid())
  accountId  String
  userId     String
  method     String
  /// With secrets kept as {{name}}.
  url        String
  status     Int?
  durationMs Int?
  size       Int?
  error      String?
  /// The request as edited (variables unresolved), to open it again.
  request    Json
  /// Status, headers, timings and the body cut to 64 KB.
  response   Json?
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, userId, createdAt])
  @@map("api_request_history")
}

/// Collection runs with their report (the latest 50 per collection kept).
model ApiTestRun {
  id               String   @id @default(uuid())
  accountId        String
  collectionId     String
  environmentId    String?
  environmentName  String?
  /// "dashboard" for now; "monitor" and "api" come with later phases.
  trigger          String   @default("dashboard")
  total            Int
  passed           Int
  failed           Int
  errored          Int
  skipped          Int      @default(0)
  assertionsPassed Int      @default(0)
  assertionsFailed Int      @default(0)
  durationMs       Int
  report           Json
  createdById      String?
  createdAt        DateTime @default(now())

  account    Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  collection ApiCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId, createdAt])
  @@index([accountId, createdAt])
  @@map("api_test_runs")
}

/// Load tests against the workspace's own tunnels, mocks and verified custom
/// domains (phase 4; engine in packages/shared/src/perf.ts). Sent to the hub
/// directly by the API instance that runs it; progress is written every
/// couple of seconds for the live chart.
model LoadTest {
  id              String    @id @default(uuid())
  accountId       String
  name            String
  /// The URL as entered (a tunnel, mock or custom-domain URL of the account).
  target          String
  /// LoadTestConfig: request, vus, durationSec, rampUpSec, thinkTimeMs, maxRps, thresholds.
  config          Json
  /// RUNNING | PASSED | FAILED | CANCELLED | ERROR
  status          String    @default("RUNNING")
  summary         Json?
  timeline        Json      @default("[]")
  error           String?
  instance        String?
  cancelRequested Boolean   @default(false)
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([status])
  @@map("load_tests")
}

/// Scheduled collection runs (phase 4). The "monitors" job runs the due ones
/// every minute; MONITOR alert rules fire on consecutive failures.
model ApiMonitor {
  id                  String    @id @default(uuid())
  accountId           String
  name                String
  collectionId        String
  environmentId       String?
  folderId            String?
  intervalMinutes     Int       @default(5)
  enabled             Boolean   @default(true)
  /// PENDING (never ran) | UP | DOWN
  status              String    @default("PENDING")
  consecutiveFailures Int       @default(0)
  lastRunAt           DateTime?
  nextRunAt           DateTime  @default(now())
  lastDurationMs      Int?
  lastError           String?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  collection ApiCollection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  results    ApiMonitorResult[]

  @@index([enabled, nextRunAt])
  @@index([accountId])
  @@map("api_monitors")
}

/// One monitor check. Kept 30 days; the report only for failed checks.
model ApiMonitorResult {
  id         String   @id @default(uuid())
  monitorId  String
  accountId  String
  at         DateTime @default(now())
  ok         Boolean
  total      Int
  passed     Int
  failed     Int
  errored    Int
  durationMs Int
  report     Json?

  monitor ApiMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, at])
  @@index([at])
  @@map("api_monitor_results")
}

enum ApiSpecVisibility {
  PRIVATE
  PUBLIC
  PASSWORD
}

/// API documentation (internal-tools/shared/api-platform-plan.md, phase 5;
/// packages/shared/src/apiSpec.ts). The draft is the text being edited; a
/// publish freezes it as an ApiSpecVersion, which is what readers see.
model ApiSpec {
  id                     String            @id @default(uuid())
  accountId              String
  name                   String
  /// Public URL: /api-docs/<workspace slug>/<slug>
  slug                   String
  description            String            @default("")
  draftText              String
  /// yaml | json — how the draft is written back after a form edit.
  draftFormat            String            @default("yaml")
  /// Bumped on every save; a stale save is refused (409).
  version                Int               @default(1)
  visibility             ApiSpecVisibility @default(PRIVATE)
  /// HMAC of the docs password (like tunnel passwords); set when PASSWORD.
  passwordHash           String?
  customDomain           String?           @unique
  customDomainToken      String?
  customDomainVerifiedAt DateTime?
  /// Mock API that "Try it" sends to on the public page (null = no try-it there).
  tryMockId              String?
  createdById            String?
  updatedById            String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  account  Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions ApiSpecVersion[]

  @@unique([accountId, slug])
  @@map("api_specs")
}

/// A published version: the text and parsed document, and what changed since the previous one.
model ApiSpecVersion {
  id            String   @id @default(uuid())
  specId        String
  accountId     String
  /// 1, 2, 3… per spec
  number        Int
  /// info.version of the document
  version       String
  text          String
  doc           Json
  /// SpecChange[] against the previous published version
  changes       Json     @default("[]")
  breaking      Int      @default(0)
  notes         String   @default("")
  publishedById String?
  createdAt     DateTime @default(now())

  spec ApiSpec @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@unique([specId, number])
  @@map("api_spec_versions")
}

// ── Team space (internal-tools/shared/api-platform-plan.md, phase 6;
// packages/shared/src/teamSpace.ts) ─────────────────────────────────────

/// A chat channel, or a direct conversation (kind DM, members only).
model TeamChannel {
  id            String    @id @default(uuid())
  accountId     String
  /// CHANNEL | DM
  kind          String    @default("CHANNEL")
  /// Unique per workspace for channels; null for DMs.
  name          String?
  topic         String    @default("")
  isPrivate     Boolean   @default(false)
  /// Sorted member ids for a DM, so the same people reuse one conversation.
  dmKey         String?
  /// A per-API channel: the object it is about (spec, mock, collection).
  refKind       String?
  refId         String?
  archivedAt    DateTime?
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account  Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members  TeamChannelMember[]
  messages TeamMessage[]

  @@unique([accountId, name])
  @@unique([accountId, dmKey])
  @@index([accountId, refKind, refId])
  @@map("team_channels")
}

/// Membership of private channels and DMs, and everyone's read position.
model TeamChannelMember {
  channelId  String
  userId     String
  accountId  String
  /// Explicit member (private channels, DMs, joined public channels).
  joined     Boolean  @default(true)
  lastReadAt DateTime @default(now())
  muted      Boolean  @default(false)
  createdAt  DateTime @default(now())

  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId, accountId])
  @@map("team_channel_members")
}

model TeamMessage {
  id          String    @id @default(uuid())
  accountId   String
  channelId   String
  /// Thread root; null for top-level messages.
  parentId    String?
  authorId    String
  body        String
  mentions    String[]  @default([])
  /// TeamRef[] found in the body (rich cards).
  refs        Json      @default("[]")
  /// { "👍": [userId, …] }
  reactions   Json      @default("{}")
  replyCount  Int       @default(0)
  lastReplyAt DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  channel TeamChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([accountId, createdAt])
  @@map("team_messages")
}

/// Realtime fan-out between API instances: each instance polls rows newer
/// than the last it saw and pushes them to its WebSocket clients. Kept a day.
model TeamEvent {
  seq       BigInt   @id @default(autoincrement())
  accountId String
  kind      String
  /// Empty = everyone in the workspace; else only these users.
  userIds   String[] @default([])
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("team_events")
}

model TeamFolder {
  id        String   @id @default(uuid())
  accountId String
  parentId  String?
  name      String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("team_folders")
}

model TeamDoc {
  id          String    @id @default(uuid())
  accountId   String
  folderId    String?
  title       String
  body        String    @default("")
  /// Bumped on every save; a stale save is refused (409).
  version     Int       @default(1)
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account  Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions TeamDocVersion[]

  @@index([accountId, folderId])
  @@map("team_docs")
}

/// History: a save more than 10 minutes after the last version (or by
/// another author) starts a new version; quick saves update the latest one.
model TeamDocVersion {
  id        String   @id @default(uuid())
  docId     String
  accountId String
  number    Int
  title     String
  body      String
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  doc TeamDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@unique([docId, number])
  @@map("team_doc_versions")
}

/// Comments on docs (optionally on one heading) and issues.
model TeamComment {
  id         String    @id @default(uuid())
  accountId  String
  /// doc | issue
  targetKind String
  targetId   String
  /// Heading anchor of a doc comment.
  anchor     String?
  authorId   String
  body       String
  mentions   String[]  @default([])
  resolvedAt DateTime?
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([targetKind, targetId, createdAt])
  @@map("team_comments")
}

model TeamIssue {
  id          String    @id @default(uuid())
  accountId   String
  /// #1, #2… per workspace
  number      Int
  title       String
  body        String    @default("")
  /// BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | DONE | CANCELLED
  status      String    @default("TODO")
  /// NONE | LOW | MEDIUM | HIGH | URGENT
  priority    String    @default("NONE")
  assigneeId  String?
  labels      String[]  @default([])
  dueDate     DateTime? @db.Date
  /// TeamRef[]: linked endpoints, requests, runs, docs…
  refs        Json      @default("[]")
  /// Board order within a status (rankBetween).
  rank        String
  createdById String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  account Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  events  TeamIssueEvent[]

  @@unique([accountId, number])
  @@index([accountId, status, rank])
  @@index([accountId, assigneeId])
  @@map("team_issues")
}

/// An issue's activity feed (created, status, assignee, … , comment).
model TeamIssueEvent {
  id        String   @id @default(uuid())
  issueId   String
  accountId String
  actorId   String?
  kind      String
  from      Json?
  to        Json?
  createdAt DateTime @default(now())

  issue TeamIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@map("team_issue_events")
}

/// Per user and workspace: the email digest switch and when it last went out.
model TeamMemberPref {
  userId       String
  accountId    String
  emailDigest  Boolean   @default(true)
  lastDigestAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@map("team_member_prefs")
}

/// One AI assist draft (phase 7): what was asked, by whom, the tokens it
/// cost, and whether it produced something. Successful rows count against
/// the plan limit aiRequestsPerMonth. The prompt and the draft are not kept.
model AiDraft {
  id           String   @id @default(uuid())
  accountId    String
  userId       String
  /// Set when an API key asked (platform API).
  keyId        String?
  /// mock | tests
  kind         String
  /// description | traffic | spec
  source       String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  ok           Boolean
  error        String?
  createdAt    DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("ai_drafts")
}
