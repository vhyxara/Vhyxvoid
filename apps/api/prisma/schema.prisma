generator client {
  provider = "prisma-client-js"
  output   = "../../../packages/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================

enum AccountType {
  PERSONAL
  ORGANIZATION
}

enum AccountStatus {
  ACTIVE
  PAST_DUE
  RESTRICTED
  SUSPENDED
  CANCELED
  DELETED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELED
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  PAUSED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  UNCOLLECTIBLE
  VOID
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ApiKeyEnvironment {
  DEV
  PROD
}

enum SecurityEventType {
  INVALID_SIGNATURE
  REPLAY_ATTACK
  RATE_LIMIT_EXCEEDED
  SCOPE_VIOLATION
  EXPIRED_KEY
}

enum NotificationType {
  EMAIL_VERIFICATION
  ACCOUNT_INVITATION
  MEMBER_JOINED
  MEMBER_REMOVED
  ROLE_CHANGED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  SUBSCRIPTION_CANCELED
  TRIAL_ENDING
  TUNNEL_DISCONNECTED
  SYSTEM_ALERT
  PASSWORD_RESET
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ==========================
// 1 User (Identity Only)
// ==========================
model User {
  id       String @id @default(uuid())
  email    String @unique
  // username        String   @unique
  password String

  firstName String @default("")
  lastName  String @default("")

  isEmailVerified     Boolean   @default(false)
  status              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  verificationTokens EmailVerificationToken[]

  accounts            AccountMember[]
  createdAccounts     Account[]            @relation("AccountCreator")
  // createdApiKeys  ApiKey[]         @relation("UserCreatedApiKeys")
  auditLogs           AuditLog[]
  accountInvitations  AccountInvitation[]
  createdApiKeys      ApiKey[]             @relation("UserCreatedApiKeys")
  revokedApiKeys      ApiKey[]             @relation("UserRevokedApiKeys")
  notifications       Notification[]
  // @@index([username])
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([status])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // ← hashed version of the raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String
  userAgent String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // FIX [7]: missing index — queries by userId were full table scans
  @@index([tokenHash])
}

model OAuthAccount {
  id         String @id @default(cuid())
  userId     String
  provider   String
  providerId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================
// 2 Account (Multi-Tenant Core)
// ==========================
model Account {
  id          String        @id @default(uuid())
  name        String
  type        AccountType
  status      AccountStatus @default(ACTIVE)
  createdById String

  createdBy User @relation("AccountCreator", fields: [createdById], references: [id])

  // Relations
  roles           Role[]
  members         AccountMember[]
  // subscription  Subscription?
  // apiKeys       ApiKey[]
  usageAggregates UsageAggregate[]
  auditLogs       AuditLog[]

  graceEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  deletedAt   DateTime?

  accountInvitations AccountInvitation[]
  // securityEvents SecurityEvent[]
  apiKeys            ApiKey[]
  securityEvents     SecurityEvent[]
  tunnelSessions     TunnelSession[]
  tunnelRequests     TunnelRequest[]
  stripeCustomerId   String? // Stripe Customer ID — set once on first checkout
  subscriptions      Subscription[]
  invoices           Invoice[]

  @@index([type])
  @@index([status])
  @@index([createdById])
}

// ==========================
// 3 AccountMember (User ↔ Account)
// ==========================
model AccountMember {
  userId    String
  accountId String
  roleId    String
  roleLevel Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([userId, accountId]) // FIX: composite PK — no phantom id column
  @@index([accountId])
  @@index([roleId])
  @@index([roleLevel]) // fast: WHERE roleLevel = 100 (count owners, etc.)
}

model AccountInvitation {
  id          String           @id @default(uuid())
  accountId   String
  email       String
  roleId      String
  roleLevel   Int
  invitedById String
  status      InvitationStatus @default(PENDING)

  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  canceledAt DateTime?

  createdAt DateTime @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  role      Role    @relation(fields: [roleId], references: [id])
  invitedBy User    @relation(fields: [invitedById], references: [id])

  @@index([accountId])
  @@index([email])
  @@index([status])
}

model Role {
  id          String  @id @default(uuid())
  accountId   String
  name        String
  description String?
  level       Int
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true) // FIX [6]: soft-deactivate custom roles

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  abilities          RoleAbility[]
  members            AccountMember[]
  accountInvitations AccountInvitation[]

  @@unique([accountId, name])
  @@index([accountId])
  @@index([level])
}

// ==========================
// 5 Ability
// ==========================
model Ability {
  id          String  @id @default(uuid())
  action      String  @unique
  description String?
  category    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  roles RoleAbility[]

  @@index([category])
}

// ==========================
// 6 Role ↔ Ability
// ==========================
model RoleAbility {
  roleId    String
  abilityId String

  assignedAt DateTime @default(now())

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  ability Ability @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  @@id([roleId, abilityId])
  @@index([roleId])
}

