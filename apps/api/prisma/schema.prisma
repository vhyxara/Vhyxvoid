// ==========================
// 12 Security Events
// ==========================

model SecurityEvent {
  id        String   @id @default(uuid())
  apiKeyId  String?
  accountId String?
  type      String // SecurityEventType enum value
  ip        String?
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  // Append-only — no updatedAt
  apiKey  ApiKey?  @relation(fields: [apiKeyId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([apiKeyId])
  @@index([accountId])
  @@index([type])
  @@index([createdAt])
}

// ==========================
// 13 Audit Logs
// ==========================
model AuditLog {
  id           String   @id @default(uuid())
  accountId    String?
  userId       String?
  targetUserId String? // affected user
  action       String
  resourceType String
  resourceId   String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  account Account? @relation(fields: [accountId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([accountId])
  @@index([userId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

