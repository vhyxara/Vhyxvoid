model ApiKey {
  id          String @id @default(uuid())
  accountId   String
  createdById String

  // Public identifier — what clients send in requests.
  // Prefixed: vhyxvoid_dev_ or vhyxvoid_live_
  // Never used as primary DB key.
  keyId String @unique

  name        String
  description String?
  environment ApiKeyEnvironment

  // Secret hashes — NEVER returned in API responses
  secretHash          String
  previousSecretHash  String? // kept during rotation grace window
  rotationGraceEndsAt DateTime? // old secret valid until this timestamp

  status      ApiKeyStatus @default(ACTIVE)
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("UserCreatedApiKeys", fields: [createdById], references: [id])
  revokedBy User?   @relation("UserRevokedApiKeys", fields: [revokedById], references: [id])

  scopes          ApiKeyScope[]
  usageAggregates UsageAggregate[]
  securityEvents  SecurityEvent[]
  tunnelSessions  TunnelSession[]
  tunnelRequests  TunnelRequest[]

  @@index([accountId])
  @@index([keyId])
  @@index([status])
  @@index([accountId, status]) // plan limit count query
  @@index([expiresAt]) // expiry worker
  @@index([rotationGraceEndsAt]) // grace cleanup worker
}

model UsageAggregate {
  id          String   @id @default(uuid())
  accountId   String
  apiKeyId    String? // null = account-level rollup
  metric      String // 'requests' | 'bandwidth_bytes' | 'tunnel_minutes'
  periodStart DateTime
  periodEnd   DateTime
  quantity    BigInt

  // reportedToStripe/stripeUsageRecordId: vestigial columns for a metered-
  // billing design that was decided against in favor of flat-rate plans
  // (see decision.md, 2026-09-13, "Billing model: flat-rate tiers"). Never
  // set to true by any code path today — kept as inert schema, not
  // dropped, since removing them would need a real migration this
  // decision doesn't require; safe to drop whenever this table is next
  // migrated for an unrelated reason.
  reportedToStripe    Boolean   @default(false)
  stripeUsageRecordId String?
  lockedAt            DateTime? // set after invoice finalization — immutable after this

  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  apiKey  ApiKey? @relation(fields: [apiKeyId], references: [id])

  // Natural unique key — prevents double-counting on flush worker retry
  @@unique([accountId, apiKeyId, metric, periodStart])
  @@index([accountId])
  @@index([apiKeyId])
  @@index([reportedToStripe])
  @@index([periodStart])
  @@index([lockedAt])
}

// ==========================
// 10 API Key Scope
// ==========================
model ApiKeyScope {
  keyId     String
  scope     String
  grantedAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [keyId], references: [id], onDelete: Cascade)

  @@id([keyId, scope])
  @@index([keyId])
}

