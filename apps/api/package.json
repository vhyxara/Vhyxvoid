{
  "name": "@vhyxvoid/api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "predev": "bash scripts/kill-zombie-dev.sh",
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json && tsc-alias",
    "generate:module": "bash scripts/create-module.sh",
    "typecheck": "tsc --noEmit",
    "test": "pnpm -w test",
    "test:watch": "pnpm -w exec vitest --config tests/vitest.config.ts",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:update": "prisma migrate dev && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "pnpm seed:abilities && pnpm seed:roles && pnpm seed:admin",
    "seed": "npm run seed:abilities && npm run seed:roles && npm run seed:admin",
    "seed:abilities": "tsx src/modules/identity/infrastructure/scripts/seed-abilities.ts",
    "seed:roles": "tsx src/modules/identity/infrastructure/scripts/seed-roles.ts",
    "seed:admin": "tsx src/modules/identity/infrastructure/scripts/seed-super-admin.ts",
    "seed:all": "tsx src/modules/identity/infrastructure/scripts/seed.ts",
    "backfill:grace-ends-at": "tsx src/modules/billing/infrastructure/scripts/backfill-grace-ends-at.ts",
    "seed:reset": "npx prisma db push --force-reset && npm run seed",
    "clean": "rm -rf dist"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.2",
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.7.0",
    "@upstash/redis": "^1.36.0",
    "@vhyxvoid/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino": "^10.1.0",
    "resend": "^6.12.0",
    "stripe": "^22.0.2",
    "uuid": "^13.0.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^6.7.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
