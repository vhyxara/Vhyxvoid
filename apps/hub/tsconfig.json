{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@platform/sdk": ["../../packages/sdk/src"],
      "@platform/shared": ["../../packages/shared/src"],
      "@platform/protocol": ["../../packages/protocol/src"],
      "@/generated/prisma": ["../../packages/shared/generated/prisma"],
      "@/generated/prisma/*": ["../../packages/shared/generated/prisma/*"],
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "generated", "prisma", "**/*.test.ts"],
  "references": [
    { "path": "../../packages/protocol" },
    { "path": "../../packages/shared" }
  ]
}
