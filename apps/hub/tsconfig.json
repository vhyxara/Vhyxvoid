{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "allowJs": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "types": ["node"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  // "include": ["./src", "**/*.ts", "**/*.tsx", "src/**/*", "apps/**/*", "types/**/*.d.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "generated", "prisma", "**/*.test.ts"]
}
