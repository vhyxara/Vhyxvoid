{
  "name": "@vhyxvoid/shared",
  "version": "1.0.0",
  "description": "Shared infrastructure — ValidateApiKeyUseCase, Prisma client, Redis client",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./generated/prisma/client": {
      "types": "./generated/prisma/client.d.ts",
      "require": "./generated/prisma/client.js",
      "import": "./generated/prisma/client.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@vhyxvoid/protocol": "workspace:*",
    "@upstash/redis": "^1.36.0",
    "@prisma/client": "^6.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^6.7.0"
  }
}
