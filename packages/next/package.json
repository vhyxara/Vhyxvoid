{
  "name": "@vhyxvoid/next",
  "version": "1.0.5",
  "description": "Zero-config tunnel for Next.js — starts automatically with next dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --external:next --external:better-sqlite3 --outfile=dist/index.js && node ../../scripts/check-dist.mjs dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tunnel",
    "nextjs",
    "next",
    "vhyxvoid",
    "ngrok",
    "hmr"
  ],
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vhyxvoid/agent": "workspace:*",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  }
}
