# syntax=docker/dockerfile:1
# API image. Build from the repo root:
#   docker build -f Dockerfile.api -t vhyxvoid-api .
FROM node:24-slim AS base
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.6.2
WORKDIR /app

FROM base AS builder
# Dependency layer keyed on the lockfile only, so source edits don't
# re-download the store.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch
COPY . .
RUN pnpm install --offline --frozen-lockfile

# Guard against stray/incomplete migration directories in the build context
# (an interrupted `prisma migrate dev` leaves one without migration.sql, and
# Prisma's P3015 check would crash-loop the container on deploy).
RUN set -e; \
    for d in apps/api/prisma/migrations/*/; do \
      [ -d "$d" ] || continue; \
      if [ ! -f "$d/migration.sql" ]; then \
        echo "ERROR: invalid Prisma migration directory (missing migration.sql): $d" >&2; \
        exit 1; \
      fi; \
    done

RUN cd apps/api && npx prisma generate
RUN find . -name "tsconfig.tsbuildinfo" -not -path "*/node_modules/*" -delete \
  && npx tsc -b tsconfig.api.json
RUN cd apps/api && npx tsc-alias -p tsconfig.json

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/protocol/dist ./packages/protocol/dist
COPY --from=builder /app/packages/protocol/package.json ./packages/protocol/
COPY --from=builder /app/packages/protocol/node_modules ./packages/protocol/node_modules
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/shared/generated ./packages/shared/generated
COPY --from=builder /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=builder /app/packages/content/dist ./packages/content/dist
COPY --from=builder /app/packages/content/package.json ./packages/content/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/bootstrap.js ./apps/api/bootstrap.js

WORKDIR /app/apps/api
USER node
EXPOSE 9000

CMD ["sh", "-c", "npx prisma migrate deploy && node bootstrap.js"]
