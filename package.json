{
  "name": "@platform/root",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @platform/api dev",
    "dev:hub": "pnpm --filter @platform/hub dev",
    "dev:agent": "pnpm --filter @platform/agent dev",
    "dev:agent-cli": "tsx packages/agent/src/cli.ts",
    "dev:sdk": "pnpm --filter @platform/sdk dev",
    "dev:shared": "pnpm --filter @platform/shared dev",
    "dev:demo-backend": "pnpm --filter @platform/demo-backend dev",
    "dev:protocol": "pnpm --filter @platform/protocol build",
    "build": "turbo run build",
    "build:api": "pnpm --filter @platform/api build",
    "build:hub": "turbo run build --filter=@platform/hub",
    "build:agent": "turbo run build --filter=@platform/agent",
    "build:sdk": "turbo run build --filter=@platform/sdk",
    "build:shared": "turbo run build --filter=@platform/shared",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:api": "pnpm --filter @platform/api test",
    "db:migrate": "pnpm --filter @platform/api db:migrate",
    "db:generate": "pnpm --filter @platform/api db:generate",
    "db:studio": "pnpm --filter @platform/api db:studio",
    "db:seed": "pnpm --filter @platform/api db:seed",
    "seed:reset": "pnpm --filter @platform/api seed:reset",
    "clean": "turbo run clean && rm -rf node_modules",
    "rebuild": "turbo run build --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.6.2",
  "dependencies": {
    "@platform/protocol": "workspace:*",
    "@platform/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.0.15"
  }
}
